// ============================================================================
// aws-rightsized.config
// ----------------------------------------------------------------------------
// Production resource-tuning overlay for epi2me-labs/wf-somatic-variation
// on AWS HealthOmics, derived from the COLO829 POC run 3295679 performance
// report (AnalyzeAHORunPerformance, 20% headroom).
//
// Apply by appending these process directives to the packaged nextflow.config
// (as was done for the POC "tuned" workflow version), then registering a new
// HealthOmics workflow version with the container_registry_map attached.
//
// Measured findings that drive these values (see analysis/.../performance-report.json):
//   - Overall CPU efficiency 48.1%, memory efficiency 15.1% -> real headroom.
//   - clairs_extract_candidates: 631 tasks, ~11% mem efficiency, max ~2 GiB /
//     ~1.65 cores. Lands on omics.m.large (8 GiB) but barely uses it. This is
//     the single biggest cost lever ($2.43 aggregate). Drop memory so it lands
//     on the cheaper c-family (omics.c.large = 2 CPU / 4 GiB).
//   - pileup_variants: NOT CPU-bound (4-25% CPU eff, ~1 core used) at the POC's
//     tuned 4-CPU allocation. Revert to 2 CPU (omics.c.large).
//   - evaluate_candidates: the POC straggler. NOT rescued by more CPU (a hard
//     full-alignment region is largely sequential). Keep 4 CPU for headroom on
//     hard regions; do NOT scale up (finer sharding is the real fix but is not
//     controllable in v1.5.1 - ClairS SelectCandidates internal, author TODO).
//   - severus (SV): thread-bound at peak (90.8% CPU on 16 threads). Left as-is;
//     keep severus_threads=16. m.4xlarge memory is over-provisioned but there
//     is no cleaner HealthOmics instance at 16 CPU / ~40 GiB.
//
// The `* task.attempt` retry multiplier is preserved everywhere so a genuine
// memory spike still retries on a larger instance rather than hard-failing.
// ============================================================================

process {

    // -- Bulk SNV candidate extraction: the dominant cost bucket ------------
    // Was cpus 2 / memory 6.GB*attempt  -> omics.m.large (2 CPU, 8 GiB)
    // Now  cpus 2 / memory 3.GB*attempt  -> omics.c.large (2 CPU, 4 GiB)
    // Observed peak ~1.97 GiB, so 3 GiB (attempt 1) is ~1.5x headroom; a real
    // spike retries at 6 GiB (attempt 2) back onto an 8 GiB instance.
    withName: 'clairs_extract_candidates' {
        cpus   = 2
        memory = { 3.GB * task.attempt }
    }

    // -- ClairS pileup NN inference: measured NOT CPU-bound -----------------
    // Revert the POC's 4-CPU experiment; ~1 core is actually used.
    withName: 'pileup_variants' {
        cpus   = 2
        memory = { 3.GB * task.attempt }
    }

    // -- Paired-tensor / prediction steps: 1-2 CPU is enough ----------------
    withName: 'clairs_create_paired_tensors' {
        cpus   = 2
        memory = { 3.GB * task.attempt }
    }
    withName: 'clairs_create_fullalignment_paired_tensors' {
        cpus   = 2
        memory = { 3.GB * task.attempt }
    }

    // -- Full-alignment candidate evaluation: the straggler -----------------
    // Keep 4 CPU for hard-region headroom. More cores do NOT help (sequential
    // region). The production fix for the tail is BATCH-LEVEL parallelism
    // (StartRunBatch, maxRuns>1) so one pair's straggler never blocks others,
    // plus the 72h run-group cap as the safety net.
    withName: 'evaluate_candidates' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
    }
}
