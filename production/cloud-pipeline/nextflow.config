//
// Notes to End Users.
//
// The workflow should run without editing this configuration file,
// however there may be instances in which you wish to edit this
// file for compute performance or other reasons. Please see:
//
//   https://nextflow.io/docs/latest/config.html#configuration
//
// for further help editing this file.


params {
    /* feature flags
    * The workflow will have similar features to the wf-human-variation:
    * 1) Short variants,
    * 2) Structural variants,
    * 3) Modified base calling,
    */
    sv = false
    mod = false
    snv = false

    // common
    bam_normal = null
    bam_tumor = null
    bam_tumor2 = null
    // CLOUD FORK: keep (publish) the in-pipeline merged tumor BAM? default false = discard.
    save_merged_tumor = false
    // CLOUD FORK: persist the ALIGNED tumor + normal BAMs (post minimap2/merge) to
    // <out_dir>/aligned_bams/ so a future run can skip the ~$22 uBAM alignment and
    // resume from the aligned BAMs. default false = discard.
    save_aligned_bams = false
    sample_name = "SAMPLE"
    ref = null
    bed = null
    tr_bed = null
    pon_file = null
    annotation = true
    out_dir = "output"
    // cloud35: minimap2 alignment sized to match cloud34-orig (baseline). Sum = 24
    // threads -> omics.c.8xlarge (32 vCPU). The right-sizing test (16 threads ->
    // c.4xlarge, run 4627214) was a poor trade: only ~10-15% cheaper but +65%+
    // wall-clock, hurting the 150-pair timeline against the 25-task concurrency wall.
    ubam_map_threads = 16
    ubam_sort_threads = 6
    ubam_bam2fq_threads = 2

    // QC metrics
    tumor_min_coverage = 20
    normal_min_coverage = 20
    depth_window_size = 50000
    depth_intervals = false

    // ClairS parameters
    override_basecaller_cfg = null
    // ClairS parameters
    normal_vcf = null
    hybrid_mode_vcf = null
    genotyping_mode_vcf = null
    skip_haplotype_filter = false
    haplotype_filter_threads = 4
    ctg_name = "EMPTY"
    include_all_ctgs = false
    snv_min_af = 0.05
    // Below will be set to 1.00 if the model is not a dna_r10 one.
    indel_min_af = 0.05
    min_contig_size = 0
    min_qual = 8
    min_cov = 4
    min_bq = null
    use_longphase = true
    use_longphase_intermediate = true
    use_normal_hets_for_phasing = true
    use_tumor_hets_for_phasing = false
    use_het_indels_for_phasing = true
    use_longphase_haplotag = true
    liquid_tumor = false
    print_ref_calls = false
    print_germline_calls = false
    germline = true
    phase_normal = false
    clairs_debug = false
    fast_mode = false
    // Clair3 parameters
    clair3_base_err = 0.001
    clair3_gq_bin_size = 5
    clair3_phase_vcf = false
    clair3_ref_pct_full = 0.1
    clair3_var_pct_full = 0.7
    clair3_min_mq = 5
    GVCF = false
    vcf_fn = "EMPTY"
    // clairs-to settings
    // CLOUD FORK (cloud26): SELF-TUNING, TIME-TARGETED depth-aware split.
    // Weight each candidate by min(depth, D_SAT)^p and cut a shard when cumulative
    // weight >= budget, where budget = clairs_target_shard_minutes*60 / k. All three
    // constants are CALIBRATED from cloud25 (run 9960545, 8539 eval shards):
    //   p = clairs_split_weight_exp = 2.5   (measured ClairS full-alignment cost
    //       exponent ~2.6, R^2=0.885 from log(cost/candidate) vs log(depth) fit;
    //       cost/candidate ~ depth^p. 2.5 = lowest shard-time CV.)
    //   D_SAT = clairs_split_depth_saturation = 73438  (depth at which per-candidate
    //       cost SATURATES: measured 60s single-candidate ceiling over 552 n=1 shards,
    //       Clair3/ClairS caps the full-alignment tensor read stack. Weight must not
    //       grow past D_SAT or the deepest loci over-fragment -> 1-min-floor waste.)
    //   k = clairs_split_cost_k = 3.603e-11  (seconds of ClairS time per unit
    //       Sum(min(d,D_SAT)^2.5); k_median from cloud25 shard-time-vs-weight.)
    // WHY: budget = T_target/k is a CONSTANT, but the split is DYNAMIC PER SAMPLE
    // because it is applied to each sample's own 500bp depth track: deeper/amplified
    // sample -> larger total weight -> more shards, each still ~T_target minutes.
    // Sim (sim_shard_deep.py) with these MEASURED constants holds MAX/p90 shard time
    // <= 1.24 across 30x-200x, massive-centromere and bimodal profiles, and the 60s
    // single-candidate ceiling guarantees no un-splittable straggler at ANY depth.
    // budget is computed in-awk from the three constants (no fragile Groovy expr).
    clairs_split_weight_exp = 2.5
    clairs_split_depth_saturation = 73438
    clairs_split_cost_k = 3.603e-11
    clairs_target_shard_minutes = 5
    // CLOUD FORK (cloud27): CHUNKED PHASING + per-chunk timeout fallback. clairs_phase
    // runs longphase per CONTIG; on COLO829 chr1 it hangs >13h at graph construction
    // (deterministic, chr1-specific; NOT depth - chr4 is deeper and finishes in 3min -
    // it is a dense/complex-variant phasing-graph blowup in the rearranged chr1). Fix:
    // split each contig into phase_chunk_size sub-regions, phase each independently with
    // a `timeout phase_timeout_min` guard; any chunk that stalls falls back to UNPHASED
    // (its input het VCF) so the run always completes. Bounds per-contig phase time to
    // ~= (n_chunks * fast) + one timeout, and isolates the pathological cluster to a
    // single chunk (only that ~20Mb loses phasing, not all of chr1). Done INSIDE the
    // clairs_phase process (no channel rewiring). ClairS uses phasing for LOCAL
    // per-candidate calling, so chunk-boundary haplotype breaks are acceptable.
    phase_chunk_size = 20000000
    phase_timeout_min = 15
    // Legacy fixed d^2 budget (cloud25). Retained ONLY as an emergency fallback and
    // for the manifest header; the cloud26 awk uses the time-targeted budget above.
    clairs_depth_split_budget = 3000000000
    // CLOUD FORK (cloud20): fine window (bp) for the dedicated split depth track;
    // small enough to resolve centromeric depth spikes the 50kb QC track dilutes.
    // cloud22: 2000->500 so the depth^2 budget (the depth-DRIVEN bound) sees the
    // true peak depth at extreme loci and self-fragments them; a candidate at
    // depth D contributes D^2 to the budget, so ultra-deep candidates form tiny
    // shards regardless of count. Per-contig awk join stays cheap (chr1 ~500k windows).
    split_depth_window_size = 500
    // CLOUD FORK: hard ceiling on candidates per eval shard, a BACKSTOP applied in
    // ADDITION to the time-targeted d^2.5 budget (which governs deep regions).
    // cloud27: raised 2000 -> 20000. DATA (cloud26): with cap 2000, 98% of the 4218
    // eval shards ran <60s (p50=32s) and were billed at the HealthOmics 1-min floor
    // (+76% tax) - because SHALLOW regions hit the count cap long before the time
    // budget, and a ~32s shard is ~20s fixed overhead + ~2000*0.006s compute (overhead
    // = 62%). The time-budget already bounds the DEEP tail (no straggler; worst 2.2min),
    // so the cap only bites shallow regions and is pure floor-billing waste there.
    // At cap 20000 a shallow shard is ~20s + ~120s ~= 2.3min (billed ~= actual, overhead
    // ~14%), collapsing ~4000 shallow shards toward a few hundred -> eval cost ~$9 -> ~$3-4.
    // SAFE: at the budget boundary a shard is ~4-5min whether deep-few or shallow-many
    // (Sum d^2.5 >= budget cuts deep first), so a higher cap does NOT reintroduce
    // stragglers; the 60s per-candidate saturation ceiling further bounds any missed spike.
    clairs_max_candidates_per_shard = 20000
    clairs_to_qual = 12
    clairs_to_min_bq = 20
    qual_cutoff_phaseable_region = 14
    qual_cutoff_unphaseable_region = 20

    // severus caller options
    severus_threads = 8
    min_sv_length = 50
    min_support = 3
    vaf_threshold = null
    severus_args = null

    // modkit
    force_strand = false
    modkit_args = null
    diff_mod = true
    dss_threads = 4
    modkit_threads = 4

    // Generic options
    help = false
    version = false
    aws_image_prefix = null
    aws_queue = null
    disable_ping = false
    igv = false

    // nfcore
    monochrome_logs = false
    validate_params = true
    show_hidden_params = false
    schema_ignore_params = 'show_hidden_params,validate_params,monochrome_logs,aws_queue,aws_image_prefix,wf,clairs_depth_split_budget,split_depth_window_size,clairs_max_candidates_per_shard,clairs_split_weight_exp,clairs_split_depth_saturation,clairs_split_cost_k,clairs_target_shard_minutes,phase_chunk_size,phase_timeout_min'

    store_dir = null

    wf {
        example_cmd = [
            "--snv",
            "--sv",
            "--mod",
            "--sample_name 'MYSAMPLE'",
            "--ref 'wf-somatic-variation-demo/GCA_000001405.15_GRCh38_no_alt_analysis_set_chr20.fna'",
            "--bed 'wf-somatic-variation-demo/demo.bed'",
            "--bam_normal 'wf-somatic-variation-demo/demo_normal.bam'",
            "--bam_tumor 'wf-somatic-variation-demo/demo_tumor.bam'",
            "--override_basecaller_cfg 'dna_r10.4.1_e8.2_400bps_sup@v3.5.2'",
            "--normal_min_coverage 0",
            "--tumor_min_coverage 0",
        ]
        container_sha = "sha5d62edcc2853ce1fd9afc244ff87e65788c4c596"
        container_snp_sha = "sha86599ecdb46472d01e0b7c2704683f6aee8a82dd"
        container_snv_to_sha = "sha0bed006dfad374401e9410b44d67e6609f7936e9"
        container_sv_sha = "sha4b941d684b3310e8524ce169da2d358a6631fab0"
        container_mod_sha = "shaa7bf2b62946eeb7646b9b9d60b892edfc3b3a52c"
        common_sha = "sha72f3517dd994984e0e2da0b97cb3f23f8540be4b"
        snpeff_tag = "sha313729d816872d70b410752001a0e2654eb88807"
        dss_sha = "sha927196d7e068cc49d5a41bcc3db91b9bdf723e7a"
        agent = null
    }
}

manifest {
    name = 'epi2me-labs/wf-somatic-variation'
    author = 'Oxford Nanopore Technologies'
    homePage = 'https://github.com/epi2me-labs/wf-somatic-variation'
    description = 'Somatic structural variants, methylation, short variants and short tandem repeat workflow'
    mainScript = 'main.nf'
    nextflowVersion = '>=23.04.2'
    version         = 'v1.5.1'
}

epi2melabs {
    tags = 'wf-somatic-variation,human,variant calling'
    icon = 'faDisease'
}


// used by default for "standard" (docker) and singularity profiles,
// other profiles may override.
process {
    container = "ontresearch/wf-somatic-variation:${params.wf.container_sha}"
    withLabel:wf_somatic_snv {
        container = "ontresearch/wf-somatic-snp:${params.wf.container_snp_sha}"
    }
    withLabel:wf_somatic_snv_to {
        container = "ontresearch/clairs-to:${params.wf.container_snv_to_sha}"
    }
    withLabel:wf_somatic_mod {
        container = "ontresearch/modkit:${params.wf.container_mod_sha}"
    }
    withLabel:dss {
        container = "ontresearch/dss:${params.wf.dss_sha}"
    }
    withLabel:wf_somatic_sv {
        container = "ontresearch/wf-somatic-sv:${params.wf.container_sv_sha}"
    }
    withLabel:wf_common {
        container = "ontresearch/wf-common:${params.wf.common_sha}"
    }
    withLabel:snpeff_annotation {
        container = "ontresearch/snpeff:${params.wf.snpeff_tag}"
    }
    shell = ['/bin/bash', '-euo', 'pipefail']
}

// ============================================================================
// CLOUD PRODUCTION right-sizing overrides (nextflow-poc-on-aws)
// Derived from COLO829 POC perf report (AnalyzeAHORunPerformance, 20% headroom).
//   - clairs_extract_candidates: 631 tasks, ~11% mem eff -> c.large (2C/4G)
//   - pileup_variants: measured NOT CPU-bound -> 2 CPU
//   - evaluate_candidates: straggler NOT rescued by more CPU -> keep 4, rely on
//     batch-level parallelism + 72h cap (finer sharding not possible in v1.5.1)
//   - merge_tumor (cloud-added): 8 CPU / 16 GiB for the ~290 GB merge
// `* task.attempt` retry multiplier preserved for genuine memory spikes.
// ============================================================================
process {
    // cloud24 right-size from cloud20 AnalyzeAHORunPerformance: these stages ran on
    // omics.r.large (16GB) at ~11-14% memory efficiency (~1.8GB actual). Drop to a
    // c.large-class base and rely on `* task.attempt` + plain 'retry' to escalate on
    // the rare deep region (HealthOmics OOM does NOT report 137/140, so the stock
    // conditional errorStrategy would hard-fail on a reduced base - override to 'retry').
    // extract_candidates uses ~1.8GB -> 4GB base is 2x headroom. pileup kept at 6GB
    // base (cloud7 OOM'd at 3GB with 20Mb chunks; 6->12->18 via retry is safe).
    withName: 'clairs_extract_candidates'              { cpus = 2; memory = { 4.GB * task.attempt }; errorStrategy = 'retry'; maxRetries = 3 }
    // cloud37-rs3 REVERT: the rs 12->8GB cut caused multi-hour pileup_variants stragglers
    // on deep pericentromeric regions (run 2022077: 5 shards >270min vs cloud36/12GB max
    // <35min). Deep regions build huge pileup tensors that THRASH under 8GB (no OOM, just
    // slow) - the perf report's "over-provisioned" verdict averaged the many small shards
    // and missed the deep tail. Back to the cloud36 known-good 12GB base (no straggler).
    withName: 'pileup_variants'                        { cpus = 2; memory = { 12.GB * task.attempt }; errorStrategy = 'retry'; maxRetries = 3 }
    // cloud37-rs3 REVERT: reverted the rs2 16->4GB cut. Same deep-region thrash risk as
    // pileup_variants (tensor size scales with local depth); the $0.07/run saving is not
    // worth risking another multi-hour straggler. Back to cloud36 known-good 16GB.
    withName: 'clairs_create_paired_tensors'           { cpus = 2; memory = { 16.GB * task.attempt } }
    withName: 'clairs_create_fullalignment_paired_tensors' { cpus = 2; memory = { 16.GB * task.attempt } }
    // CLOUD FORK: eval memory is driven by local read depth, not candidate count.
    // A few shards over deep loci exceed 4GB. HealthOmics OOM does NOT report exit
    // 137/140, so the process now uses plain errorStrategy 'retry' + maxRetries 4;
    // this base escalates 8->16->24->32->40GB so any deep shard self-heals.
    withName: 'evaluate_candidates'                    { cpus = 2; memory = { 8.GB * task.attempt } }
    withName: 'clairs_predict_pileup'                   { cpus = 2; memory = { 12.GB * task.attempt } }
    // CLOUD FORK (cloud30): makeModReport (methylation HTML report over the whole
    // genome via pandas) base was 6GB and OOM'd on attempt 1 in cloud29 (~2h wasted
    // before the exit-137 retry succeeded at 12GB). Raise base to 16GB so it succeeds
    // first try; plain 'retry' (not the [137,140] conditional) so any OOM self-heals
    // 16->32->48GB regardless of how HealthOmics reports the kill.
    withName: 'makeModReport'                          { cpus = 1; memory = { 16.GB * task.attempt }; errorStrategy = 'retry'; maxRetries = 2 }
    // cloud37-rs2 SPEED: mod:dss was the longest single task in run 9369634 (~141 min) on
    // omics.r.xlarge using only 1 of 4 CPUs (dss_threads default 1). DSS supports up to 4
    // threads; use all 4 (dss_threads=4) at cpus=4 -> same r.xlarge instance ($0 extra),
    // ~halves the DSS wall-clock. Memory bumped (4 threads need more) with retry headroom.
    withName: 'dss'                                    { cpus = params.dss_threads; memory = { 32.GB * task.attempt }; errorStrategy = 'retry'; maxRetries = 2 }
    // cloud37-rs2 COST: alignment_stats:bamstats ran on omics.c.4xlarge (16 CPU) at <50%
    // efficiency -> omics.c.2xlarge (8C/16G). Biggest single right-size in the report
    // after pileup (~$0.13/run). Ample headroom; QC stat pass, not on the critical path.
    withName: 'bamstats'                               { cpus = 8; memory = { 16.GB * task.attempt } }
}
