// tumor-bam-merge HealthOmics workflow config
//
// Container: samtools from the biocontainers image. The account already has a
// quay.io ECR pull-through cache (prefix "quay"), so the container registry map
// on the workflow rewrites quay.io -> the private ECR quay prefix and
// HealthOmics pulls it through. samtools is the only tool required.
//
// manifest.version pinned so the merge step is reproducible alongside the
// v1.5.1 main pipeline.

manifest {
    name        = 'tumor-bam-merge'
    description = 'HealthOmics pre-step: merge 2 tumor BAMs into 1 sorted+indexed BAM'
    version     = 'v1.0.0'
    mainScript  = 'main.nf'
    nextflowVersion = '>=23.10.0'
}

params.out_dir = 'output'

process {
    // biocontainers samtools 1.19.2 (same image used throughout the POC merge).
    container = 'quay.io/biocontainers/samtools:1.19.2--h50ea8bc_0'
    withName: 'merge_tumor'        { container = 'quay.io/biocontainers/samtools:1.19.2--h50ea8bc_0' }
    withName: 'passthrough_normal' { container = 'quay.io/biocontainers/samtools:1.19.2--h50ea8bc_0' }
    shell = ['/bin/bash', '-euo', 'pipefail']
}
