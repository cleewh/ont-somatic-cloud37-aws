{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ReadInputs",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": [
        "arn:aws:s3:::ont-lrs-somatic-poc-apse1-687677765589/inputs/*",
        "arn:aws:s3:::ont-lrs-somatic-poc-apse1-687677765589/workflow-artifacts/*",
        "arn:aws:s3:::ont-lrs-somatic-poc-apse1-687677765589/run-cache/*",
        "arn:aws:s3:::ont-lrs-somatic-poc-apse1-687677765589/outputs/*"
      ]
    },
    {
      "Sid": "S3WriteOutputs",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:AbortMultipartUpload"],
      "Resource": [
        "arn:aws:s3:::ont-lrs-somatic-poc-apse1-687677765589/outputs/*",
        "arn:aws:s3:::ont-lrs-somatic-poc-apse1-687677765589/analysis/*",
        "arn:aws:s3:::ont-lrs-somatic-poc-apse1-687677765589/run-cache/*"
      ]
    },
    {
      "Sid": "S3ListBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::ont-lrs-somatic-poc-apse1-687677765589",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["inputs/*", "workflow-artifacts/*", "outputs/*", "analysis/*", "run-cache/*"]
        }
      }
    },
    {
      "Sid": "ECRAccessForPullThroughCache",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchCheckLayerAvailability"
      ],
      "Resource": "arn:aws:ecr:ap-southeast-1:687677765589:repository/docker-hub/*"
    },
    {
      "Sid": "ECRAuthToken",
      "Effect": "Allow",
      "Action": ["ecr:GetAuthorizationToken"],
      "Resource": "*"
    },
    {
      "Sid": "CloudWatchLogsWrite",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:CreateLogGroup",
        "logs:DescribeLogStreams"
      ],
      "Resource": "arn:aws:logs:ap-southeast-1:687677765589:log-group:/aws/omics/*"
    }
  ]
}
